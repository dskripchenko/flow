{
  "name": "@dskripchenko/flow",
  "version": "1.1.1",
  "description": "Process and state-machine graphs: a zero-dependency TypeScript core (model, validation, layered layout, monitoring state, polling, undoable editing commands) and Vue components on @dskripchenko/ui — viewer, live monitoring overlay, drill-down and a visual editor",
  "keywords": [
    "flow",
    "state-machine",
    "workflow",
    "process",
    "bpm",
    "graph",
    "diagram-editor",
    "node-editor",
    "monitoring",
    "sugiyama",
    "svg",
    "vue",
    "zero-dependency"
  ],
  "homepage": "https://github.com/dskripchenko/flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dskripchenko/flow.git"
  },
  "bugs": {
    "url": "https://github.com/dskripchenko/flow/issues"
  },
  "license": "MIT",
  "author": "Denis Skripchenko (https://github.com/dskripchenko)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./mermaid": {
      "types": "./dist/mermaid.d.ts",
      "import": "./dist/mermaid.mjs",
      "require": "./dist/mermaid.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.cjs"
    },
    "./style.css": "./dist/style.css",
    "./standalone": "./dist/standalone.js",
    "./standalone.css": "./dist/standalone.css",
    "./schema/graph.schema.json": "./schema/graph.schema.json",
    "./schema/snapshot.schema.json": "./schema/snapshot.schema.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/standalone.js"
  ],
  "files": [
    "dist",
    "!dist/**/*.map",
    "schema",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json && vue-tsc --noEmit -p tsconfig.vue.json && vite build && vite build -c vite.standalone.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.vue.json",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "check:browser": "node scripts/browser-check.mjs",
    "dev": "vite --config playground/vite.config.ts",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@dskripchenko/diagrams": "^1.1.0",
    "@dskripchenko/ui": "^1.15.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@dskripchenko/diagrams": {
      "optional": true
    },
    "@dskripchenko/ui": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@dskripchenko/diagrams": "^1.1.0",
    "@dskripchenko/ui": "^1.15.0",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^29.1.1",
    "lucide-vue-next": "0.460.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
